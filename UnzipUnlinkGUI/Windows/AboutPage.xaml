<Window x:Class="UnzipUnlinkGUI.Windows.AboutPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Unzip &amp; Unlink"
        Width="660" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Unzip &amp; Unlink" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Text="Version" Margin="0,2,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" LineHeight="21"
                               Text="We hope this program helps you in some way. If you find it useful I would love to hear so! Please feel free to reach out with any thoughts for future improvements or issues." />
                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink NavigateUri="mailto:markba122@gmail.com" RequestNavigate="Hyperlink_RequestNavigate">markba122@gmail.com</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="128" Height="148" CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="/Windows/Casey.JPG" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border Width="128" Height="148" CornerRadius="8" Margin="12,0,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="/Windows/GitHub.JPG" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="For issues please go to" />
                        <TextBlock Margin="0,3,0,0">
                            <Hyperlink NavigateUri="https://github.com/brianmanderson/Unzip_Unlink_Csharp"
                                       RequestNavigate="Hyperlink_RequestNavigate">github.com/brianmanderson/Unzip_Unlink_Csharp</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Check out other tools at my GitHub" />
                        <TextBlock Margin="0,3,0,0">
                            <Hyperlink NavigateUri="https://github.com/BrianMAnderson"
                                       RequestNavigate="Hyperlink_RequestNavigate">github.com/BrianMAnderson</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Grid.Row="3" Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                    MinWidth="96" Padding="18,7" Margin="0,20,0,0" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
