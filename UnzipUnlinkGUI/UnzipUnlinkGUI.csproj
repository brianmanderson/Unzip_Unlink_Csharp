<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UnzipUnlinkGUI</AssemblyName>
    <RootNamespace>UnzipUnlinkGUI</RootNamespace>
    <Version>2.0.0</Version>
    <Product>Unzip &amp; Unlink</Product>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF's implicit usings leave System.IO out. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnzipUnlink.Core\UnzipUnlink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Windows\Casey.JPG" />
    <Resource Include="Windows\GitHub.JPG" />
  </ItemGroup>

</Project>
