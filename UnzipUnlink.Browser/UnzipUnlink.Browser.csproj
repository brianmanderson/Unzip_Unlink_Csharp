<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    Browser-only edition: the UnzipUnlink.Core engine compiled to WebAssembly and driven from a Web Worker
    (wwwroot/engine-worker.js) by the same four-step UI as UnzipUnlink.Web. Purely static output:
      dotnet publish UnzipUnlink.Browser/UnzipUnlink.Browser.csproj -c Release -o publish/pages
    produces the site in publish/pages/wwwroot. Every URL in it is relative, so it can be served from a sub-path.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>UnzipUnlink.Browser</RootNamespace>
    <AssemblyName>UnzipUnlinkBrowser</AssemblyName>
    <Version>2.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The worker imports _framework/dotnet.js by a fixed name; import maps do not reach into workers. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- Nothing in the app needs these; leaving them out keeps the first download small. -->
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <WasmEnableWebcil>true</WasmEnableWebcil>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnzipUnlink.Core\UnzipUnlink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- fo-dicom is not trim-annotated (IL2104). Keep it whole so code paths the tests do not reach (character
         sets, transcoders, things it finds by reflection) behave exactly as in the native build. -->
    <TrimmerRootAssembly Include="fo-dicom.core" />
  </ItemGroup>

</Project>
