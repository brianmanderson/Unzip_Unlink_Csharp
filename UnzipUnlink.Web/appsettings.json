{
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UnzipUnlink": {
    // Who may point the app at a folder on the machine it runs on (and browse its drives):
    //   "LoopbackOnly" - only a browser on this same machine (default)
    //   "Always"       - anyone who can reach the site (only for a trusted, access-controlled network)
    //   "Never"        - upload / download only
    "LocalFolders": "LoopbackOnly",
    // Where uploaded studies are held while they are processed. Empty = the system temp folder.
    "WorkspaceRoot": "",
    // Uploaded studies are deleted after this many idle minutes (and always on shutdown).
    "RetentionMinutes": 60,
    // Largest total upload for one job, in megabytes.
    "MaxUploadMegabytes": 20480,
    // Open the default browser when the app starts on this machine.
    "OpenBrowser": true,
    // When "Urls" is a plain http://localhost:<port> and that port is taken by another program, use the next
    // free port instead of failing. (A second copy of this app just opens the first one.)
    "AutoPort": true
  }
}
